<Window x:Class="DesktopDrawers.Views.DrawerSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Personalizar cajón" Width="390" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F5FA">
 <StackPanel Margin="24">
  <TextBlock Text="Nombre"/><TextBox x:Name="DrawerName" MaxLength="100"/>
  <TextBlock Text="Fondo · HEX #RRGGBB"/><TextBox x:Name="BackgroundHex"/>
  <TextBlock Text="Título · HEX #RRGGBB"/><TextBox x:Name="TitleHex"/>
  <TextBlock Text="Opacidad del fondo · 10–100 %"/>
  <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12"/>
  <TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:F0} %}"/>
  <WrapPanel Margin="0,16,0,0"><Button Content="Guardar" Click="Save" IsDefault="True"/><Button Content="Cancelar" IsCancel="True"/><Button Content="Eliminar…" Click="Delete"/></WrapPanel>
 </StackPanel>
</Window>
