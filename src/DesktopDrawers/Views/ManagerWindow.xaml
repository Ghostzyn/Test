<Window x:Class="DesktopDrawers.Views.ManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Desktop Drawers" Width="530" Height="450" MinWidth="430" MinHeight="350" Background="#F3F5FA" WindowStartupLocation="CenterScreen">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Desktop Drawers" FontSize="28" FontWeight="SemiBold"/><TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Text="Tus accesos, en su lugar. Arrastra archivos .lnk o .url desde el escritorio a un cajón."/></StackPanel>
  <WrapPanel Grid.Row="1"><Button Content="＋ Nuevo cajón" Click="Create"/><Button Content="Mostrar / ocultar" Click="Toggle"/><Button Content="Restaurar todo" Click="Restore"/></WrapPanel>
  <ListBox x:Name="Drawers" Grid.Row="2" Margin="0,12" DisplayMemberPath="Name" MouseDoubleClick="Edit"/>
  <StackPanel Grid.Row="3"><TextBlock TextWrapping="Wrap" Text="Ctrl+Alt+D: mostrar / ocultar. Doble clic en la lista: personalizar. Los cajones se ocultan al activar otras aplicaciones." Foreground="#475569"/><Button Content="Guardar y salir" HorizontalAlignment="Right" Click="Exit"/></StackPanel>
 </Grid>
</Window>
