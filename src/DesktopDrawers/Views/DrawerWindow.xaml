<Window x:Class="DesktopDrawers.Views.DrawerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" MinWidth="240" MinHeight="44" AllowDrop="True" PreviewDrop="OnDrop" PreviewDragOver="OnDragOver" PreviewDragEnter="OnDragOver" DragLeave="OnDragLeave" SizeChanged="GeometryChanged" LocationChanged="LocationChangedHandler">
 <Border x:Name="Frame" CornerRadius="12" BorderBrush="#607B8799" BorderThickness="1" Padding="4">
 <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="Transparent" MouseLeftButtonDown="DragHeader" MouseMove="MoveHeader" MouseLeftButtonUp="EndHeaderDrag" LostMouseCapture="EndHeaderCapture"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="TitleText" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <Button Grid.Column="1" Content="⚙" ToolTip="Personalizar / eliminar" Click="Settings" Padding="6,0"/>
   <Button x:Name="Arrow" Grid.Column="2" Content="▾" ToolTip="Expandir / contraer" Click="ToggleExpanded" Padding="6,0"/>
  </Grid>
  <ListBox x:Name="Items" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="Open" PreviewMouseLeftButtonDown="RememberDrag" PreviewMouseMove="StartDrag" PreviewMouseRightButtonDown="SelectRightClicked">
   <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Width="82" Margin="3,7" ToolTip="{Binding Name}"><Image Source="{Binding Icon}" Width="32" Height="32"/><TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   <ListBox.ContextMenu><ContextMenu><MenuItem Header="Abrir" Click="Open"/><MenuItem Header="Restaurar al escritorio (quitar del cajón)" Click="Restore"/></ContextMenu></ListBox.ContextMenu>
  </ListBox>
  <Thumb x:Name="ResizeGrip" Grid.Row="1" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeDrawer" ToolTip="Cambiar tamaño"/>
  <Border x:Name="DropHint" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False" Background="#EA172235" CornerRadius="8" BorderBrush="#60A5FA" BorderThickness="2" Margin="6">
   <TextBlock Text="Soltar accesos aquí" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
  </Border>
 </Grid></Border>
</Window>
